APP_MODE=demo
DEMO_MODE=true
DEMO_SEED=7
DEMO_RESET_ON_START=false
DEMO_ALLOW_EXTERNAL_MODELS=false
PROMPT_ADMIN_ENABLED=false

APP_DATA_DIR=./data
APP_DB_PATH=./data/interview_orchestration_demo.sqlite3
PROMPT_ACTIVE_FILE=./data/active_prompt.json
PROMPT_VERSIONS_DIR=./prompts/versions

LLM_BACKEND=mock
REQUEST_TIMEOUT_SECONDS=30

